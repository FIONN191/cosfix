{
  "name": "cosfix",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "app:dev": "VITE_DEV_SERVER_URL=http://localhost:5178 electron .",
    "dist": "npm run build && mkdir -p '/Volumes/SN580 1TB Media/开发/CosFix/tmp' && TMPDIR='/Volumes/SN580 1TB Media/开发/CosFix/tmp' electron-builder --mac --win",
    "dist:mac": "npm run build && mkdir -p '/Volumes/SN580 1TB Media/开发/CosFix/tmp' && TMPDIR='/Volumes/SN580 1TB Media/开发/CosFix/tmp' electron-builder --mac"
  },
  "dependencies": {
    "exifr": "^7.1.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.8",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "tailwindcss": "^4.1.8",
    "typescript": "^5.7.0",
    "vite": "^6.3.5",
    "vitest": "^3.0.0"
  },
  "build": {
    "appId": "com.fionn.cosfix",
    "productName": "CosFix",
    "directories": {
      "output": "/Volumes/SN580 1TB Media/开发/CosFix/release"
    },
    "files": [
      "dist/**",
      "electron/**",
      "package.json"
    ],
    "mac": {
      "icon": "build/icon.icns",
      "target": [
        {
          "target": "dmg",
          "arch": ["universal"]
        }
      ],
      "artifactName": "CosFix-${version}-mac.${ext}",
      "category": "public.app-category.photography"
    },
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "artifactName": "CosFix-Setup-${version}-win-x64.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
